# Dependencies
node_modules/
apps/chat/node_modules/
apps/chat/.next/

# Env
.env
.env.local
.env.*.local

# OS / IDE
.DS_Store
*.log
.turbo/

# AOR control plane is strapped during the demo. Not committed.
vendor/*
!vendor/.gitkeep

# AOR-generated drafts (regenerate with npm run specs)
.aor/generated-control-plane/

# Pack and capability schema are generated by npm run contracts. Not committed.
contracts/packs/*
!contracts/packs/.gitkeep
contracts/capability/*
!contracts/capability/.gitkeep

# Specs are generated by npm run specs. Not committed.
# Training results stay local. The chatbot reads latest.md.
specs/*
!specs/.gitkeep
!specs/training/
specs/training/*
!specs/training/results/
specs/training/results/*
!specs/training/results/.gitkeep

# Local captures. Not part of the docs.
docs/evidence/*
!docs/evidence/.gitkeep
