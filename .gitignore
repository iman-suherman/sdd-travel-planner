# Dependencies
node_modules/
apps/chat/node_modules/
apps/chat/.next/

# Env
.env
.env.local
.env.*.local

# OS / IDE
.DS_Store
*.log
.turbo/

# AOR-generated drafts (regenerate with npm run train:aor)
.aor/generated-control-plane/

# Specs are generated by npm run demo / npm run train:aor. Not committed.
# Training results stay local. The chatbot reads latest.md.
specs/*
!specs/.gitkeep
!specs/training/
specs/training/*
!specs/training/results/
specs/training/results/*
!specs/training/results/.gitkeep

# Local captures. Not part of the docs.
docs/evidence/*
!docs/evidence/.gitkeep
